[Desktop Entry]
Name=WallShuffle
Comment=Lightweight, privacy-first wallpaper manager
Exec=wallshuffle
Icon=io.github.kayab999.WallShuffle
Terminal=false
Type=Application
Categories=Settings;DesktopSettings;
Keywords=wallpaper;background;changer;shuffle;
StartupNotify=true
StartupWMClass=io.github.kayab999.WallShuffle
X-GNOME-Autostart-enabled=true
Actions=NextWallpaper;

[Desktop Action NextWallpaper]
Name=Next Wallpaper
Exec=wallshuffle --change
